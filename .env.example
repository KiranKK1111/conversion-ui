# Copy this file to `.env` and edit values to match your Postgres setup.
# Defaults mirror the existing backend's .env (kept in sync on purpose).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=kittu
DB_SCHEMA=nature_risk

# Absolute path to the model-tune folder (holds the conversion scripts).
# If left blank, the app assumes it sits at the repo root next to conversion-ui/.
MODEL_TUNE_DIR=

# Where conversion outputs are staged before/after they're written to the DB.
WORK_DIR=./_work
